{% extends 'base.html.twig' %}

{% block title %}Upload{% endblock %}

{% block body %}
    <h1>Upload</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ upload.id }}</td>
            </tr>
            <tr>
                <th>Filename</th>
                <td>{{ upload.filename }}</td>
            </tr>
            <tr>
                <th>Ajouté le : </th>
                <td>{{ upload.createdAt ? upload.createdAt|date('d-m-Y H:i') : '' }}</td>
            </tr>
            <tr>
                <th>Taille du fichier</th>
                <td>{{ upload.fileSize | format_bytes }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_upload_index', {'username': username}) }}">back to list</a>

    {{ include('upload/_delete_form.html.twig') }}
{% endblock %}
