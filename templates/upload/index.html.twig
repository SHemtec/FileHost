{% extends 'base.html.twig' %}

{% block title %}Mes fichiers{% endblock %}

{% block body %}
    <main class="w-full flex flex-col text-white">

        <h1 class="text-center my-12 mt-16 text-6xl text-indigo-400 font-bold">Téléchargez vos fichiers</h1>

        <section class=" p-3 sm:p-5 my-16">
            <div class="mx-auto w-9/12 lg:px-12">
                <!-- Start coding here -->
                <div class=" bg-slate-800 relative shadow-md sm:rounded-lg overflow-hidden">
                    <div class="flex flex-col md:flex-row items-center justify-between space-y-3 md:space-y-0 md:space-x-4 p-4">
                        <div class="w-full md:w-1/2">
                            <form class="flex items-center">
                                <label for="simple-search" class="sr-only">Rechercher</label>
                                <div class="relative w-full">
                                    <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                                        <svg aria-hidden="true" class="w-5 h-5 text-slate-500 text-slate-400" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                                        </svg>
                                    </div>
                                    <input type="text" id="simple-search" class="bg-slate-700 border border-gray-300  text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block w-full pl-10 p-2 bg-slate-700 border-slate-600 placeholder-gray-400 text-white focus:ring-indigo-500 focus:border-indigo-500" placeholder="Rechercher" required="">
                                </div>
                            </form>
                        </div>
                        <div class="w-full md:w-auto flex flex-col md:flex-row space-y-2 md:space-y-0 items-stretch md:items-center justify-end md:space-x-3 flex-shrink-0">
                            <a type="button" href="{{ path('app_upload_new', {'username': username}) }}" class="flex items-center justify-center text-white bg-indigo-700 hover:bg-indigo-800 focus:ring-4 focus:ring-indigo-300 font-medium rounded-lg text-sm px-4 py-2 bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-indigo-800">
                                <svg class="h-3.5 w-3.5 mr-2" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path clip-rule="evenodd" fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" />
                                </svg>
                                Telecharger un fichier
                            </a>
                            <div class="flex items-center space-x-3 w-full md:w-auto">
                                <button id="actionsDropdownButton" data-dropdown-toggle="actionsDropdown" class="w-full md:w-auto flex items-center justify-center py-2 px-4 text-sm font-medium focus:outline-none  rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-indigo-700 focus:z-10 focus:ring-4 focus:ring-gray-200 focus:ring-gray-700 bg-gray-800 text-gray-400 border-slate-600 hover:text-white hover:bg-slate-700" type="button">
                                    <svg class="-ml-1 mr-1.5 w-5 h-5" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <path clip-rule="evenodd" fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
                                    </svg>
                                    Actions
                                </button>
                                <div id="actionsDropdown" class="hidden z-10 w-44  rounded divide-y divide-gray-100 shadow bg-gray-700 divide-gray-600">
                                    <div class="py-1">
                                        <a href="#" class="block py-2 px-4 text-sm text-gray-700 hover:bg-gray-100 hover:bg-gray-600 text-gray-200 hover:text-white">Tout supprimer</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-sm text-left text-slate-500 text-slate-400">
                            <thead class="text-xs text-gray-700 uppercase bg-slate-50 bg-slate-700 text-gray-400">
                            <tr class="text-indigo-400">
                                <th scope="col" class="px-4 py-3">Nom du fichier</th>
                                <th scope="col" class="px-4 py-3">Ajouté le</th>
                                <th scope="col" class="px-4 py-3">Sera supprimé le</th>
                                <th scope="col" class="px-4 py-3">
                                    <span class="sr-only">Actions</span>
                                </th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for upload in uploads %}
                            <tr class="border-b border-indigo-800">
                                <th scope="row" class="px-4 py-3 font-medium  whitespace-nowrap text-indigo-400">{{ upload.filename | remove_namer_suffix }}</th>
                                <td class="px-4 py-3">{{ upload.createdAt ? upload.createdAt|date('d/m/Y H:i') : '' }}</td>
                                <td class="px-4 py-3">{{ upload.deleteAt | date('d/m/Y H:i') }}</td>
                                <td class="px-4 py-3 flex items-center justify-end">
                                    <button id="{{ upload.filename }}-dropdown-button" data-dropdown-toggle="{{ upload.filename }}-dropdown" class="inline-flex items-center p-0.5 text-sm font-medium text-center text-slate-500 hover:text-indigo-600 rounded-lg focus:outline-none hover:text-indigo-100" type="button">
                                        <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewbox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M6 10a2 2 0 11-4 0 2 2 0 014 0zM12 10a2 2 0 11-4 0 2 2 0 014 0zM16 12a2 2 0 100-4 2 2 0 000 4z" />
                                        </svg>
                                    </button>
                                    <div id="{{ upload.filename }}-dropdown" class="hidden z-10 w-44  rounded divide-y divide-slate-100 shadow bg-slate-700 divide-slate-600">
                                        <ul class="py-1 text-sm text-gray-700 text-gray-200" aria-labelledby="{{ upload.filename }}-dropdown-button">
                                            {% if upload.link %}
                                            <li>
                                                <a href="{{ path('app_download',{'slug': upload.link.slug}) }}" class="block py-2 px-4 hover:bg-slate-100 hover:bg-indigo-600 hover:text-white">Acceder au lien</a>
                                            </li>
                                            {% else %}
                                                <li>
                                                    <a href="{{ path('app_dl_link', {'id': upload.id}) }}" class="block py-2 px-4 hover:bg-slate-100 hover:bg-indigo-600 hover:text-white">Générer un lien</a>
                                                </li>
                                            {% endif %}
                                        </ul>
                                        <div class="py-1">
                                            {{ include('upload/_delete_form.html.twig') }}
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}

                            </tbody>
                        </table>
                    </div>
                    <nav class="flex flex-col md:flex-row justify-between items-start md:items-center space-y-3 md:space-y-0 p-4" aria-label="Table navigation">
                        <span class="text-sm font-normal text-slate-500 text-slate-400">
                            {% if uploads %}
                            <span id="file-count" class="font-semibold text-white">{{ uploads | length }}</span>
                            Fichier(s) trouvé(s)
                            {% else %}
                            Aucun fichier trouvé
                            {% endif %}
                        </span>
                    </nav>
                </div>
            </div>
        </section>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const searchInput = document.getElementById('simple-search');
            const tableRows = document.querySelectorAll('tbody tr');
            const fileCountSpan = document.getElementById('file-count');

            searchInput.addEventListener('input', function () {
                const searchTerm = searchInput.value.toLowerCase();
                let visibleRowCount = 0;

                tableRows.forEach(row => {
                    const fileName = row.querySelector('th').textContent.toLowerCase();
                    if (fileName.includes(searchTerm)) {
                        row.style.display = '';
                        visibleRowCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                fileCountSpan.textContent = visibleRowCount;
            });
        });
    </script>
{% endblock %}
