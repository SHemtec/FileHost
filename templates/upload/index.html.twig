{% extends 'base.html.twig' %}

{% block title %}Upload index{% endblock %}

{% block body %}
    <h1>Bonjour {{ username }}</h1>

    <h2>Vos téléchargements : </h2>
    <table class="table">
        <thead>
            <tr>
                <th>Nom du fichier</th>
                <th>Ajouté  le</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for upload in uploads %}
            <tr>
                <td>{{ upload.filename }}</td>
                <td>{{ upload.createdAt ? upload.createdAt|date('d/m/Y H:i') : '' }}</td>
                <td>
                    <a href="{{ path('app_upload_show', {'id': upload.id, 'username': username}) }}">show</a>
                    <a href="{{ path('app_dl_link',{'id': upload.id}) }}">Generer un lien</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_upload_new', {'username': username}) }}">Create new</a>
{% endblock %}
