<form method="post" action="{{ path('app_upload_delete', {'id': upload.id, 'username': username}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ upload.id) }}">
    <button class="bg-red-400 p-2 px-3 rounded-md">Supprimer</button>
</form>
