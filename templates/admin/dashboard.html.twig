{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content %}
    <section class="">
        <h1>Panel</h1>
        <div style="height: 35%">
            <canvas id="userChart"></canvas>
        </div>
        <div style="height: 35%">
            <canvas id="uploadChart"></canvas>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // User Chart
            var userData = JSON.parse('{{ userData|raw }}');
            var userLabels = userData.map(item => item.date);
            var userValues = userData.map(item => item.count);
            var userChart = new Chart(document.getElementById('userChart'), {
                type: 'line',
                data: {
                    labels: userLabels,
                    datasets: [{
                        label: 'Nombre d\'utilisateurs',
                        data: userValues,
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 3,
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        tension: 0.4,
                        borderCapStyle: 'round'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });

            // Upload Chart
            var uploadData = JSON.parse('{{ uploadData|raw }}');
            var uploadLabels = uploadData.map(item => item.date);
            var uploadValues = uploadData.map(item => item.count);
            var uploadChart = new Chart(document.getElementById('uploadChart'), {
                type: 'line',
                data: {
                    labels: uploadLabels,
                    datasets: [{
                        label: 'Nombre d\'uploads',
                        data: uploadValues,
                        borderColor: 'rgba(153, 102, 255, 1)',
                        borderWidth: 3,
                        backgroundColor: 'rgba(153, 102, 255, 0.2)',
                        tension: 0.4,
                        borderCapStyle: 'round'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });
        });
    </script>
{% endblock %}