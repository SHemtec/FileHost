{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <main class="bg-white dark:bg-slate-900 flex justify-center flex-col items-center p-20 w-full">
        <form method="post" class="w-1/2 flex justify-center items-center flex-col text-indigo-400 gap-6 p-5 border-2 py-16 border-indigo-600 rounded-2xl">
            <h1 class="text-5xl text-violet-500 my-6">Inscription</h1>

            {{ form_row(form._token) }}

            {% for flash_message in app.flashes('error') %}
                <div class="bg-red-500 text-white p-3 rounded-md text-center">
                    {{ flash_message }}
                </div>
            {% endfor %}

            <section class="flex flex-col w-9/12">
                <label for="username" class="text-violet-400 mx-2 my-3 text-2xl">Nom d'utilisateur *</label>
                {{ form_widget(form.username, {'attr': {'class': 'border-2 border-indigo-600 rounded-md bg-slate-900 p-4 placeholder:text-indigo-400'}}) }}
            </section>

            <section class="flex flex-col w-9/12">
                <label for="email" class="text-violet-400 mx-2 my-3 text-2xl">Email *</label>
                {{ form_widget(form.email, {'attr': {'class': 'border-2 border-indigo-600 rounded-md bg-slate-900 p-4 placeholder:text-indigo-400'}}) }}
            </section>

            <section class="flex flex-col w-9/12">
                <label for="password" class="text-violet-400 mx-2 my-3 text-2xl">Mot de passe *</label>
                {{ form_widget(form.password, {'attr': {'class': 'border-2 border-indigo-600 rounded-md bg-slate-900 p-4 placeholder:text-indigo-400'}}) }}
            </section>

            <section class="flex flex-col w-9/12">
                <label for="description" class="text-violet-400 mx-2 my-3 text-2xl">Description *</label>
                {{ form_widget(form.description, {'attr': {'class': 'border-2 border-indigo-600 rounded-md bg-slate-900 p-4 placeholder:text-indigo-400'}}) }}
            </section>

            <button class="p-3 px-5 bg-violet-600 text-white rounded-md my-6" type="submit">
                S'inscrire
            </button>
        </form>
    </main>
{% endblock %}
