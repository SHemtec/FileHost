<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}

            <style>
                /* Slide-in animation */
                @keyframes slideIn {
                    from {
                        transform: translateX(100%);
                        opacity: 0;
                    }
                    to {
                        transform: translateX(0);
                        opacity: 1;
                    }
                }

                /* Slide-out animation */
                @keyframes slideOut {
                    from {
                        transform: translateX(0);
                        opacity: 1;
                    }
                    to {
                        transform: translateX(100%);
                        opacity: 0;
                    }
                }

                .flash-success {
                    animation: slideIn 0.5s forwards;
                }

                .flash-success.closing {
                    animation: slideOut 0.5s forwards;
                }

                .flash-error {
                    animation: slideIn 0.5s forwards;
                }

                .flash-error.closing {
                    animation: slideOut 0.5s forwards;
                }

                .flash-alert {
                    animation: slideIn 0.5s forwards;
                }

                .flash-alert.closing {
                    animation: slideOut 0.5s forwards;
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}

            <script>
                document.addEventListener("DOMContentLoaded", function() {
                    function handleFlashMessages(selector) {
                        document.querySelectorAll(selector).forEach(function(flashMessage) {
                            // ferme automatiquement la notif
                            setTimeout(function() {
                                flashMessage.classList.add('closing');
                                setTimeout(function() { flashMessage.remove(); }, 500); // attends que l'animation se finisse
                            }, 3000);

                            // Ferme la notif si on clique sur l'icone
                            flashMessage.querySelector('.close-btn').addEventListener('click', function() {
                                flashMessage.classList.add('closing');
                                setTimeout(function() { flashMessage.remove(); }, 500); // utilise remove() pour supprimer l'élément du DOM
                            });
                        });
                    }

                    handleFlashMessages('.flash-success');
                    handleFlashMessages('.flash-error');
                    handleFlashMessages('.flash-alert');
                });
            </script>
        {% endblock %}
    </head>
    <body class="bg-slate-900 text-white dark">
        {% block navbar %}
            {% if app.user %}
                {% include '_partials/nav.html.twig' %}
            {% endif %}
        {% endblock %}

        {% block body %}{% endblock %}

        {% for flash_message in app.flashes('success') %}
            <div class="flash-success fixed bottom-20 right-10 text-center py-4 lg:px-4">
                <div class="p-2 bg-emerald-800 items-center text-indigo-100 leading-none lg:rounded-full flex lg:inline-flex" role="alert">
                    <span class="flex rounded-full bg-emerald-500 uppercase px-2 py-1 text-xs font-bold mr-3">OK</span>
                    <span class="font-semibold mr-2 text-left flex-auto">{{ flash_message }}</span>
                    <svg class="close-btn cursor-pointer fill-current opacity-75 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M12.95 10.707l.707-.707L8 4.343 6.586 5.757 10.828 10l-4.242 4.243L8 15.657l4.95-4.95z"/></svg>
                </div>
            </div>
        {% endfor %}

        {% for flash_message in app.flashes('error') %}
            <div class="flash-error fixed bottom-20 right-10 text-center py-4 lg:px-4">
                <div class="p-2 bg-red-800 items-center text-indigo-100 leading-none lg:rounded-full flex lg:inline-flex" role="alert">
                    <span class="flex rounded-full bg-red-500 uppercase px-2 py-1 text-xs font-bold mr-3">ERREUR</span>
                    <span class="font-semibold mr-2 text-left flex-auto">{{ flash_message }}</span>
                    <svg class="close-btn cursor-pointer fill-current opacity-75 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M12.95 10.707l.707-.707L8 4.343 6.586 5.757 10.828 10l-4.242 4.243L8 15.657l4.95-4.95z"/></svg>
                </div>
            </div>
        {% endfor %}

        {% for flash_message in app.flashes('alert') %}
            <div class="flash-alert fixed bottom-20 right-10 text-center py-4 lg:px-4">
                <div class="p-2 bg-orange-800 items-center text-orange-100 leading-none lg:rounded-full flex lg:inline-flex" role="alert">
                    <span class="flex rounded-full bg-orange-500 uppercase px-2 py-1 text-xs font-bold mr-3">ALERTE</span>
                    <span class="font-semibold mr-2 text-left flex-auto">{{ flash_message }}</span>
                    <svg class="close-btn cursor-pointer fill-current opacity-75 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M12.95 10.707l.707-.707L8 4.343 6.586 5.757 10.828 10l-4.242 4.243L8 15.657l4.95-4.95z"/></svg>
                </div>
            </div>
        {% endfor %}

        {% block footer %}
            {% include '_partials/footer.html.twig' %}
        {% endblock %}
    </body>
</html>
