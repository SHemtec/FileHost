{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <main class="bg-white dark:bg-slate-900 flex justify-center flex-col items-center p-20 w-full">
        <form method="post" class="w-1/2 flex justify-center items-center flex-col text-indigo-400 gap-6 p-5 border-2 py-16 border-indigo-600 rounded-2xl">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <h1 class="text-5xl text-violet-500 my-6">Connexion</h1>

            <section class="flex flex-col w-9/12">
                <label for="username" class="text-violet-400 mx-2 my-3 text-2xl">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="border-2 border-indigo-600 rounded-md bg-slate-900 p-4 placeholder:text-indigo-400" placeholder="Email" autocomplete="email" required autofocus>
            </section>

            <section class="flex flex-col w-9/12">
                <label for="password" class="text-violet-400 mx-2 my-3 text-2xl">Mot de passe</label>
                <input type="password" name="_password" id="password" class="border-2 border-indigo-600 rounded-md bg-slate-900 p-4 placeholder:text-indigo-400" placeholder="Mot de passe" autocomplete="current-password" required>
            </section>

            <input type="hidden" name="_csrf_token"
                   value="{{ csrf_token('authenticate') }}"
            >

            {#
            Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
            See https://symfony.com/doc/current/security/remember_me.html

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Remember me</label>
            </div>
            #}

            <button class="p-3 px-5 bg-violet-600 text-white rounded-md my-6" type="submit">
                Connexion
            </button>
        </form>
    </main>
{% endblock %}
