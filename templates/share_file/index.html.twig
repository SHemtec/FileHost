{% extends 'base.html.twig' %}

{% block title %}Lien{% endblock %}

{% block body %}
    <h1>Lien Généré</h1>

    <p>Nom du fichier : {{ upload.fileName }}</p>
    <p>Taille du fichier : {{ upload.fileSize | format_bytes}}</p>

    <p><a href="{{ path('app_dl_file', {'slug': upload.link.slug}) }}">Télécharger le fichier</a></p>
{% endblock %}
