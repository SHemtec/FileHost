{% extends 'base.html.twig' %}

{% block title %}Profile{% endblock %}

{% block body %}
    <main class="bg-white dark:bg-slate-900 flex justify-center flex-col items-center p-20">
        <div class=" xl:w-1/2 sm:w-full flex justify-center items-center flex-col text-indigo-400 gap-6 p-5 border-2 py-16 border-indigo-600 rounded-2xl">
            <h1 class="text-5xl text-violet-500 my-6">Profile Utilisateur</h1>

            <section class="flex flex-col w-9/12">
                <label class="text-violet-400 mx-2 my-3 text-2xl">Nom d'utilisateur</label>
                <p class="border-2 border-indigo-600 rounded-md bg-slate-900 p-4">{{ user.username }}</p>
            </section>

            <section class="flex flex-col w-9/12">
                <label class="text-violet-400 mx-2 my-3 text-2xl">Email</label>
                <p class="border-2 border-indigo-600 rounded-md bg-slate-900 p-4">{{ user.email }}</p>
            </section>

            <section class="flex flex-col w-9/12">
                <label class="text-violet-400 mx-2 my-3 text-2xl">Nombre d'uploads</label>
                <p class="border-2 border-indigo-600 rounded-md bg-slate-900 p-4">{{ user.uploadCount }}</p>
            </section>

            <section class="flex flex-col w-9/12">
                <label class="text-violet-400 mx-2 my-3 text-2xl">Inscrit depuis le</label>
                <p class="border-2 border-indigo-600 rounded-md bg-slate-900 p-4">{{ user.createdAt ? user.createdAt|date('d/m/Y') : '' }}</p>
            </section>

            <a href="{{ path('app_profile_edit', {'username': user.username}) }}" class="p-3 px-5 bg-violet-600 text-white rounded-md my-6">
                Modifier
            </a>
        </div>
    </main>
{% endblock %}
