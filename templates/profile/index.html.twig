{% extends 'base.html.twig' %}

{% block title %}Hello ProfileController!{% endblock %}

{% block body %}
    <h1>{{ user.username }}'s Profile</h1>
    <h2>Uploads</h2>
    <ul>
        {% for upload in user.uploads %}
            <li>{{ upload.filename }}</li>
        {% endfor %}
    </ul>
{% endblock %}
